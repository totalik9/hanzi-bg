# ---- Generated content (regenerate with pipeline/) ----
# The raw downloads are 130+ MB and every artefact is reproducible from
# pipeline/. Only the code belongs in version control.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.mp3
*.sqlite
*.sqlite3

# ---- Android / Gradle ----
.gradle/
build/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.iml
.idea/
*.hprof

# Kotlin
.kotlin/

# ---- Release signing ----
# The signing key and its passwords are secrets. They live outside the
# repository (see C:\Users\IPP\.hanzi-bg) and are copied in here only
# while a release is being built.
keystore.properties
*.jks
*.keystore

# ---- CI diagnostics ----
# The emulator job writes what it saw into instrumented-diagnostics/ so
# a failing run can be read without admin rights on the repository. It
# is an output, not code.
/instrumented-diagnostics/

# ---- Session recordings ----
# The student session of 2026-11-23: a 60-minute screen recording of
# the app, 139 screenshots and the frames of the video. It is evidence
# for the findings in LEARNING-PROCESS-PLAN.md, not code, and it is
# 115 MB. The plan says what the recording shows.
/recordings/

# ---- Simulation output ----
# results.json and analysis_output.txt are run outputs and are not tracked.
/simulation/results.json
/simulation/analysis_output.txt
# expected_vectors.json IS tracked: CI diffs it against the Kotlin test
# vectors to catch scheduler drift, and `git diff` on an untracked file
# silently passes, which would make that check vacuous.

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
*~
.idea/
