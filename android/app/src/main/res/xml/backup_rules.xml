<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules: the content DB is re-downloadable, but user progress
  (SRS state) MUST be backed up so a device swap does not lose streaks.
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
    <include domain="database" path="hanzi_user.db" />
    <exclude domain="file" path="content/content.db" />
    <exclude domain="file" path="content/content.db-wal" />
    <exclude domain="file" path="content/content.db-shm" />
</full-backup-content>
