{
  "units": [
    {
      "key": "intro",
      "title": "Първи стъпки",
      "lessons": [
        {
          "key": "intro-pinyin",
          "title": "Пиньин и срички",
          "kind": "teach",
          "cards": [
            {
              "kind": "text",
              "title": "Два начина да запишеш една дума",
              "body": "Китайският се пише с йероглифи, но звукът му се записва с латински букви. Това се нарича пиньин. Йероглифът носи смисъла, пиньинът носи звука."
            },
            {
              "kind": "items",
              "title": "Една дума, два записа",
              "body": "",
              "items": [
                { "hanzi": "你好", "pinyin": "nǐ hǎo", "text": "здравей" },
                { "hanzi": "谢谢", "pinyin": "xièxie", "text": "благодаря" },
                { "hanzi": "中国", "pinyin": "Zhōngguó", "text": "Китай" }
              ]
            },
            {
              "kind": "text",
              "title": "Сричката се състои от две части",
              "body": "Начална съгласна + крайна гласна. Например ní = n + i. Сричките се пишат без разделител, а тонът се отбелязва с знак над буквата."
            },
            {
              "kind": "table",
              "title": "Начални съгласни",
              "body": "",
              "rows": [
                ["b", "p", "m", "f"],
                ["d", "t", "n", "l"],
                ["g", "k", "h"],
                ["j", "q", "x"],
                ["zh", "ch", "sh", "r"],
                ["z", "c", "s"],
                ["y", "w"]
              ]
            },
            {
              "kind": "table",
              "title": "Крайни гласни",
              "body": "",
              "rows": [
                ["a", "o", "e"],
                ["i", "u", "ü"],
                ["ai", "ei"],
                ["ao", "ou"],
                ["an", "en"],
                ["ang", "eng", "ong"],
                ["er"]
              ]
            },
            {
              "kind": "text",
              "title": "Едно изключение",
              "body": "След zh, ch, sh, r, z, c и s се пише i, но то не се произнася само: zhi се чете „джи“. След j, q, x се пише ü: ju се чете „цю“."
            },
            {
              "kind": "items",
              "title": "Изслушай и повтори",
              "body": "",
              "items": [
                { "hanzi": "你好", "pinyin": "nǐ hǎo", "text": "здравей" },
                { "hanzi": "谢谢", "pinyin": "xièxie", "text": "благодаря" },
                { "hanzi": "中国", "pinyin": "Zhōngguó", "text": "Китай" },
                { "hanzi": "学生", "pinyin": "xuéshēng", "text": "ученик" }
              ]
            }
          ]
        },
        {
          "key": "intro-tones",
          "title": "Четирите тона",
          "kind": "teach",
          "cards": [
            {
              "kind": "text",
              "title": "Височината е част от думата",
              "body": "В българския няма тонове. В китайския има четири: една и съща сричка с различен тон е различна дума. Затова тонът се записва — върху буквата, а не в отделна сричка."
            },
            {
              "kind": "items",
              "title": "Тон 1 — равен и висок",
              "body": "",
              "items": [
                { "hanzi": "一", "pinyin": "yī", "text": "едно" },
                { "hanzi": "天", "pinyin": "tiān", "text": "небе" }
              ]
            },
            {
              "kind": "items",
              "title": "Тон 2 — издига се",
              "body": "",
              "items": [
                { "hanzi": "学", "pinyin": "xué", "text": "уча" },
                { "hanzi": "年", "pinyin": "nián", "text": "година" }
              ]
            },
            {
              "kind": "items",
              "title": "Тон 3 — пада и се връща",
              "body": "",
              "items": [
                { "hanzi": "你", "pinyin": "nǐ", "text": "ти" },
                { "hanzi": "好", "pinyin": "hǎo", "text": "добър" }
              ]
            },
            {
              "kind": "items",
              "title": "Тон 4 — пада рязко",
              "body": "",
              "items": [
                { "hanzi": "四", "pinyin": "sì", "text": "четири" },
                { "hanzi": "是", "pinyin": "shì", "text": "е" }
              ]
            },
            {
              "kind": "items",
              "title": "Една сричка, различен тон",
              "body": "Слушай ги една след друга — тонът променя думата.",
              "items": [
                { "hanzi": "喝", "pinyin": "hē", "text": "пия (тона 1)" },
                { "hanzi": "和", "pinyin": "hé", "text": "и (тона 2)" },
                { "hanzi": "十", "pinyin": "shí", "text": "десет (тона 2)" },
                { "hanzi": "是", "pinyin": "shì", "text": "е (тона 4)" }
              ]
            },
            {
              "kind": "text",
              "title": "Правило за трети тон",
              "body": "Когато два трети тона са един до друг, първият се произнася с втория тон. Това идва по-нататък — засега е достатъчно да слушаш."
            }
          ]
        }
      ]
    }
  ]
}
